{
  "info": {
    "name": "Qicau — L1 API Contract",
    "description": "Black-box contract tests for POST /api/parse-audio and POST /api/parse-text, written only from test/Qicau.md §10 (API-01..10). Folders are grouped by whether they spend real Gemini quota when run against production: 'Negative & Edge Cases' and 'Non-API routes' never reach the AI (rejected earlier, or don't touch it); 'Contract — parse-text/audio' and 'Fallback & Errors' do call the AI (real on production, mocked on local-dev via environments/stubs/gemini-fetch-mock.cjs). See test-plan.md §3.1/§3.4.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Negative & Edge Cases (no AI call expected — safe to run anywhere)",
      "item": [
        {
          "name": "API-02 — Missing textInput returns 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('error field present', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('error');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/parse-text"
          }
        },
