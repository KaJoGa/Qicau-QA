    {
      "name": "Boundary — uncertain AI cost (ask before running on production)",
      "item": [
        {
          "name": "Boundary — whitespace-only textInput (beyond literal spec text, worth checking)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Qicau.md API-02 only says 'string kosong' (empty string) must 400.",
                  "// This checks whether that same intent extends to whitespace-only input.",
                  "// Whatever the actual result is, record it — don't assume either way.",
                  "// NOTE: if the server does NOT reject this before calling the AI, this",
                  "// request may spend real Gemini quota on production — that's the one",
                  "// thing about this specific request that isn't guaranteed zero-cost,",
                  "// which is why it's kept out of the 'safe to run anywhere' folder.",
                  "pm.test('record actual status for whitespace-only input', () => {",
                  "  pm.collectionVariables.set('whitespace_status_observed', pm.response.code);",
                  "  console.log('whitespace-only textInput -> HTTP', pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"textInput\": \"   \"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/parse-text"
          }
        }
      ]
    },
    {
      "name": "Contract — parse-text (calls real AI on production; mocked on local-dev)",
      "item": [
        {
          "name": "API-04/05 — Valid text input returns well-formed result",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('response has a result field', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('result');",
                  "  pm.expect(body.result).to.be.a('string');",
                  "  pm.collectionVariables.set('lastResult', body.result);",
                  "});",
                  "",
                  "pm.test('result string parses as JSON with all required fields (API-04)', () => {",
                  "  const parsed = JSON.parse(pm.collectionVariables.get('lastResult'));",
                  "  ['kategori','platform','harga','detail','payment_method','confidence','raw_transcript']",
                  "    .forEach((field) => pm.expect(parsed).to.have.property(field));",
                  "  pm.collectionVariables.set('lastParsed', JSON.stringify(parsed));",
                  "});",
                  "",
                  "pm.test('field values respect the enums/types (API-05)', () => {",
                  "  const parsed = JSON.parse(pm.collectionVariables.get('lastParsed'));",
                  "  const kategoriValid = ['Makan','Jajan','Transport','Belanja','Tagihan','Lainnya'];",
                  "  const paymentValid = ['QRIS','Cash','Transfer','GoPay','OVO','DANA','ShopeePay','Kartu','Paylater'];",
                  "  const confidenceValid = ['high','medium','low'];",
                  "  pm.expect(kategoriValid).to.include(parsed.kategori);",
                  "  pm.expect(paymentValid).to.include(parsed.payment_method);",
                  "  pm.expect(confidenceValid).to.include(parsed.confidence);",
                  "  pm.expect(parsed.harga).to.be.a('number');",
                  "  pm.expect(Number.isInteger(parsed.harga)).to.be.true;",
                  "  pm.expect(parsed.harga).to.be.at.least(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"textInput\": \"Beli kopi goceng di Starbucks pakai gopay\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/parse-text"
          }
        }
      ]
    },
    {
      "name": "Contract — parse-audio — API-06 (data-driven, real webm fixtures — see api-testing/data/audio)",
      "item": [
        {
          "name": "API-06 — Missing mimeType is still processed (treated as webm)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Run with: newman run <collection> -e <env> --folder \"Contract — parse-audio — API-06 ...\" -d api-testing/data/audio/webm-fixtures.json",
                  "// Each iteration sends a genuine .webm recording with NO mimeType field — this",
                  "// is what actually exercises 'missing mimeType is treated as webm', unlike the",
                  "// placeholder bytes used in an earlier pass (which only proved Gemini rejects",
                  "// garbage content, not that the mimeType-defaulting path works).",
                  "pm.test(`[${pm.iterationData.get('fixture')}] status is 200 (real audio, no mimeType, processed successfully)`, () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(`[${pm.iterationData.get('fixture')}] result has all required fields with valid enums (API-04/05 shape)`, () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('result');",
                  "  const parsed = JSON.parse(body.result);",
                  "  ['kategori','platform','harga','detail','payment_method','confidence','raw_transcript']",
                  "    .forEach((field) => pm.expect(parsed).to.have.property(field));",
                  "  const kategoriValid = ['Makan','Jajan','Transport','Belanja','Tagihan','Lainnya'];",
                  "  const paymentValid = ['QRIS','Cash','Transfer','GoPay','OVO','DANA','ShopeePay','Kartu','Paylater'];",
                  "  const confidenceValid = ['high','medium','low'];",
                  "  pm.expect(kategoriValid).to.include(parsed.kategori);",
                  "  pm.expect(paymentValid).to.include(parsed.payment_method);",
                  "  pm.expect(confidenceValid).to.include(parsed.confidence);",
                  "  pm.expect(Number.isInteger(parsed.harga)).to.be.true;",
                  "  console.log(`[${pm.iterationData.get('fixture')}] raw_transcript:`, parsed.raw_transcript);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"audioBase64\": \"{{audioBase64}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/parse-audio"
          }
        }
      ]
    },
    {
      "name": "Contract — parse-audio (calls real AI on production; mocked on local-dev)",
      "item": [
        {
          "name": "API-09 — Large payload is not rejected for size (up to 50MB)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Builds a ~5MB base64 filler string at request time so we don't need to",
                  "// commit a large binary fixture to the repo. Not valid audio — this test",
                  "// only checks that size isn't the reason for any rejection, not that",
                  "// garbage audio parses successfully.",
                  "pm.collectionVariables.set('bigAudioBase64', 'A'.repeat(5 * 1024 * 1024));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('not rejected specifically for payload size (no 413, no size-related error message)', () => {",
                  "  pm.expect(pm.response.code).to.not.equal(413);",
                  "  if (pm.response.code >= 400) {",
                  "    const body = pm.response.json();",
                  "    const msg = (body && body.error || '').toString().toLowerCase();",
                  "    pm.expect(msg).to.not.include('size');",
                  "    pm.expect(msg).to.not.include('large');",
                  "    pm.expect(msg).to.not.include('limit');",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"audioBase64\": \"{{bigAudioBase64}}\", \"mimeType\": \"audio/webm\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/parse-audio"
          }
        }
      ]
    },
